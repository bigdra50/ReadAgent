{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ブラウザ向けはバンドラ解決を使う。NodeNext と違い相対 import に .js を付けない。
    // リポジトリ内で唯一の例外なので、他パッケージのやり方を持ち込まないこと。
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
