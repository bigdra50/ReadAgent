{
  "name": "@readagent/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Agent SDK 連携。選択範囲を起点にした問い合わせとカスタムツール",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@readagent/core": "workspace:*",
    "@readagent/pdf": "workspace:*"
  }
}
